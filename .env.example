# Shared household password (required)
HOUSEHOLD_PASSWORD=change-me

# Session signing secret (required, long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# LibSQL / Turso (optional — without these, uses local file ./data/haushalt.db)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
